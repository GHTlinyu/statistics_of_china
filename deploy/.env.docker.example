# 生产环境变量模板
# 用法：cp deploy/.env.docker.example deploy/.env.docker 后填入真实值
# 注意：本文件是模板，.env.docker 包含密钥，禁止提交到 git
#
# 读取机制：compose 的 env_file 把本文件解析成 backend 容器的环境变量，
# 容器内没有 .env 文件；代码的配置读取器环境变量优先，直接生效。

# ---------- 数据库（宿主机 PostgreSQL，host 网络下走本机回环） ----------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=statistics_of_china
DB_USER=postgres
DB_PASSWORD=CHANGE_ME

# ---------- JWT ----------
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING
JWT_EXPIRE_MINUTES=1440

# ---------- 验证码（可选，默认 300 秒 / 4 位） ----------
# CAPTCHA_TTL_SECONDS=300
# CAPTCHA_LENGTH=4

# ---------- 对话大模型（OpenAI 兼容协议） ----------
LLM_API_KEY=CHANGE_ME
LLM_BASE_URL=CHANGE_ME
LLM_MODEL=CHANGE_ME
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

# ---------- Embedding / Rerank（Jina，检索链路） ----------
LLM_EMBEDDING_API_KEY=CHANGE_ME
LLM_EMBEDDING_BASE_URL=https://api.jina.ai/v1
LLM_EMBEDDING_MODEL=jina-embeddings-v5-text-small
# LLM_EMBEDDING_DIMENSIONS=1024
LLM_RERANK_API_KEY=CHANGE_ME
LLM_RERANK_BASE_URL=https://api.jina.ai/v1
LLM_RERANK_MODEL=jina-reranker-v3.5

# ---------- 检索超时（可选） ----------
# RAG_TIMEOUT_SECONDS=30
# RAG_MAX_RETRIES=2
